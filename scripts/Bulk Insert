
create or alter procedure bronze.load_bronze as 
begin
		declare @start_time datetime, @end_time datetime
begin try
  print '=================================='
  print 'Loading Bronze layer'
  print '=================================='

  print 'Loading CRM Tables'
  print '**********************'
------------------   BULK INSERT   --------------

						--1
set @start_time = getdate()
truncate table bronze.crm_cust_info
bulk insert bronze.crm_cust_info
from 'C:\Users\waseem.a\Downloads\sql-data-warehouse-project (1)\sql-data-warehouse-project\datasets\source_crm\cust_info.csv'
with
(
firstrow = 2,
fieldterminator = ',',
tablock

)

set @end_time = getdate()
print '>> Load Duration' + cast (datediff(second, @start_time, @end_time) as nvarchar) + 'seconds'
print '----------------------------------'
------------------   BULK INSERT   --------------
						--2
set @start_time = getdate()
truncate table bronze.crm_prod_info
bulk insert bronze.crm_prod_info
from 'C:\Users\waseem.a\Downloads\sql-data-warehouse-project (1)\sql-data-warehouse-project\datasets\source_crm\prd_info.csv'
with
(
firstrow = 2,
fieldterminator = ',',
tablock

)
set @end_time = getdate()
print '>> Load Duration' + cast (datediff(second, @start_time, @end_time) as nvarchar) + 'seconds'
print '----------------------------------'

------------------   BULK INSERT   --------------
						--3
set @start_time = getdate()
truncate table bronze.crm_sales_details
bulk insert bronze.crm_sales_details
from 'C:\Users\waseem.a\Downloads\sql-data-warehouse-project (1)\sql-data-warehouse-project\datasets\source_crm\sales_details.csv'
with
(
firstrow = 2,
fieldterminator = ',',
tablock

)
set @end_time = getdate()
print '>> Load Duration' + cast (datediff(second, @start_time, @end_time) as nvarchar) + 'seconds'
print '----------------------------------'

  print 'Loading ERP Tables'
  print '**********************'

------------------   BULK INSERT   --------------
						--4
set @start_time = getdate()
truncate table bronze.erp_CUST_AZ12
bulk insert bronze.erp_CUST_AZ12
from 'C:\Users\waseem.a\Downloads\sql-data-warehouse-project (1)\sql-data-warehouse-project\datasets\source_erp\CUST_AZ12.csv'
with
(
firstrow = 2,
fieldterminator = ',',
tablock

)
set @end_time = getdate()
print '>> Load Duration' + cast (datediff(second, @start_time, @end_time) as nvarchar) + 'seconds'
print '----------------------------------'


------------------   BULK INSERT   --------------
						--5
set @start_time = getdate()
truncate table bronze.erp_LOC_A101
bulk insert bronze.erp_LOC_A101
from 'C:\Users\waseem.a\Downloads\sql-data-warehouse-project (1)\sql-data-warehouse-project\datasets\source_erp\LOC_A101.csv'
with
(
firstrow = 2,
fieldterminator = ',',
tablock

)
set @end_time = getdate()
print '>> Load Duration' + cast (datediff(second, @start_time, @end_time) as nvarchar) + 'seconds'
print '----------------------------------'

------------------   BULK INSERT   --------------
						--6
set @start_time = getdate()
truncate table bronze.erp_PX_CAT_G1V2
bulk insert bronze.erp_PX_CAT_G1V2
from 'C:\Users\waseem.a\Downloads\sql-data-warehouse-project (1)\sql-data-warehouse-project\datasets\source_erp\PX_CAT_G1V2.csv'
